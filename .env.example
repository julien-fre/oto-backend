# oto-mcp environment variables
# All variables configured here are loaded from the process environment.
# In production, use a secure secrets manager (1Password, AWS Secrets Manager, etc.).
# Locally, copy this file to .env and fill in test/dev values.

# =============================================================================
# AUTHENTICATION & IDENTITY
# =============================================================================

# Logto OAuth 2.0 configuration (required for production)
LOGTO_ENDPOINT=https://auth.oto.ninja
# Alternative Logto endpoint for graceful migration between Logto instances (optional)
LOGTO_ENDPOINT_ALT=
# Public endpoint advertised to clients (if different from LOGTO_ENDPOINT)
# Used when the signing endpoint differs from the public endpoint (e.g., internal vs external domain)
LOGTO_PUBLIC_ENDPOINT=

# MCP (Model Context Protocol) audience — the URL this server announces to clients (required)
# Production: https://mcp.oto.cx/mcp
# Preprod: https://mcp.oto.ninja/mcp
MCP_AUDIENCE=https://mcp.oto.ninja/mcp

# Secondary MCP audiences for multi-domain support (optional, comma-separated)
# Used when serving the same backend on multiple domains (e.g., both oto.cx and oto.ninja)
# Format: https://mcp.oto.cx/mcp,https://other.example.com/mcp
MCP_AUDIENCE_ALT=

# Minimum token issued-at (iat) claim required to accept a JWT (optional, Unix timestamp)
# Set to current time to invalidate all existing tokens without restarting Logto
# Useful for emergency token rotation
MIN_TOKEN_IAT=0

# Admin account subject (sub) for bootstrapping super_admin permissions (optional)
# Must match a valid Logto user sub; leave empty for no auto-admin
OTO_MCP_ADMIN_SUB=

# Developer account subject for testing/debugging (optional)
# Bypasses some restrictions in development mode
OTO_MCP_DEV_SUB=

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================

# Master encryption key for credential vault (required in production)
# AES-256-GCM key (base64-encoded 32 bytes). All connector credentials are encrypted with this.
# ⚠️ Rotation requires re-encryption of all stored credentials — backup before changing.
# Generated: `openssl rand -base64 32`
OTO_MCP_MASTER_KEY=

# OAuth state secret for signing upload tokens and unsubscribe links (required if uploads or outreach enabled)
# Used to prevent CSRF and token replay attacks
# Minimum 32 random bytes, base64-encoded or raw hex
# Generated: `openssl rand -base64 32`
OTO_MCP_OAUTH_STATE_SECRET=

# Allowed redirect URIs for Dynamic Client Registration (optional, comma-separated)
# If set, DCR can only register callbacks to these hosts
# Format: https://example.com,https://app.example.com
OTO_MCP_DCR_ALLOWED_REDIRECTS=

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/dbname
# For production, use a managed database service (AWS RDS, Azure Database, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/oto_mcp

# Database connection pool — maximum concurrent connections (optional)
# Default: 20
OTO_MCP_DB_POOL_MAX=20

# Database connection pool — timeout waiting for available connection in seconds (optional)
# Default: 10
OTO_MCP_DB_POOL_TIMEOUT=10

# Idle transaction timeout in milliseconds (optional)
# Closes transactions that remain idle longer than this period
# Default: 60000 (60 seconds)
OTO_MCP_DB_IDLE_TX_TIMEOUT_MS=60000

# Statement timeout in milliseconds (optional)
# Aborts SQL queries that run longer than this period
# Default: 30000 (30 seconds)
OTO_MCP_DB_STATEMENT_TIMEOUT_MS=30000

# Database initialization — number of retry attempts (optional)
# Used during server startup when applying migrations
# Default: 5
OTO_MCP_INIT_DB_ATTEMPTS=5

# Database initialization — lock acquisition timeout in milliseconds (optional)
# Prevents multiple processes from racing during DDL application
# Default: 5000 (5 seconds)
OTO_MCP_INIT_DB_LOCK_TIMEOUT_MS=5000

# =============================================================================
# STORAGE — S3 / Scaleway Object Storage (optional)
# =============================================================================
# Required if avatar uploads, org logos, or email images are enabled.

# S3-compatible endpoint (required if storage enabled)
# Example: https://s3.fr-par.scw.cloud (Scaleway fr-par region)
OTO_MCP_S3_ENDPOINT=

# S3 region (optional)
# Default: fr-par (Scaleway France-Paris)
# Used for virtual-hosted-style URLs if OTO_MCP_S3_PUBLIC_BASE_URL is not set
OTO_MCP_S3_REGION=fr-par

# S3 bucket name (required if storage enabled)
OTO_MCP_S3_BUCKET=

# S3 access key (required if storage enabled)
# For Scaleway, use an Object Storage API key
OTO_MCP_S3_ACCESS_KEY=

# S3 secret key (required if storage enabled)
# For Scaleway, use the corresponding Object Storage API secret
OTO_MCP_S3_SECRET_KEY=

# Public base URL for S3 objects (optional)
# If set, uploaded images are served from this URL instead of S3 direct URLs
# Useful for CDN integration or custom domain serving
# Example: https://cdn.oto.cx or https://media.s3.fr-par.scw.cloud
OTO_MCP_S3_PUBLIC_BASE_URL=

# Maximum image size for uploads in bytes (optional)
# Default: 2097152 (2 MB)
OTO_MCP_S3_MAX_IMAGE_BYTES=2097152

# Presigned URL expiration time in seconds (optional)
# Controls how long S3 presigned URLs remain valid
# Default: 3600 (1 hour)
OTO_MCP_S3_PRESIGN_EXPIRY=3600

# =============================================================================
# EMAIL & COMMUNICATION
# =============================================================================

# Email service endpoint (optional)
# Used for transactional emails, invitations, outreach campaigns
# Example: https://mailer.oto.zone/api/send
OTO_MAILER_URL=

# Bearer token for email service authentication (optional, if OTO_MAILER_URL is set)
# Provides authentication to the mailer endpoint
OTO_MAILER_SEND_BEARER=

# From address for emails sent by the platform (optional)
# Format: noreply@example.com or "Platform Name <noreply@example.com>"
# If not set, a default is used
OTO_MAIL_FROM=

# Recipient email for contact form submissions (optional)
# Where contact form messages are forwarded
OTO_CONTACT_TO=

# =============================================================================
# BILLING & PAYMENTS (optional, set OTO_BILLING_ENABLED=1 to activate)
# =============================================================================

# Enable billing system (optional)
# Default: 0 (disabled)
# Set to 1 to activate subscription management and payment processing
OTO_BILLING_ENABLED=0

# Enable billing background worker (optional)
# Default: 1 (enabled in production only)
# Processes recurring charges, invoices, and billing updates
# Set to 0 to disable background billing tasks
OTO_BILLING_RUNNER_ENABLED=1

# Mollie API key for payment processing (required if OTO_BILLING_ENABLED=1)
# Obtain from https://www.mollie.com/
# Used for subscription management, invoicing, and payment webhooks
MOLLIE_API_KEY=

# =============================================================================
# THIRD-PARTY API CREDENTIALS (optional)
# =============================================================================

# Mistral API key for LLM services (optional)
MISTRAL_API_KEY=

# FOD (Fichier Ouvert de Données) France — API token for business data lookups (optional)
FOD_API_TOKEN=
FOD_BASE_URL=https://api.fod.fr

# FOD timeout for individual DVF (land registry) queries in seconds (optional)
# Default: 5
FOD_DVF_TIMEOUT_S=5

# FOD retry configuration — number of retry attempts (optional)
# Default: 3
FOD_RETRY_ATTEMPTS=3

# FOD retry backoff — initial backoff in seconds (optional)
# Default: 1
FOD_RETRY_BACKOFF_S=1

# FOD retry — maximum backoff between retries in seconds (optional)
# Default: 10
FOD_RETRY_AFTER_MAX_S=10

# French directors (board members) update frequency in seconds (optional)
# Default: 86400 (24 hours)
FR_DIRECTORS_CADENCE_S=86400

# Browserbase API key and project ID for browser automation (optional)
# Used for cookie-bound API scraping with persistent browser state
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Google Workspace OAuth credentials (optional)
# Used for Gmail/Google Drive/Google Sheets integration
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Logodev token for company logo fetching (optional)
LOGODEV_TOKEN=

# =============================================================================
# ERROR TRACKING & MONITORING
# =============================================================================

# Sentry DSN for error tracking (optional)
# Leave empty to disable error tracking
# Format: https://<key>@<org>.ingest.sentry.io/<project>
OTO_SENTRY_DSN=

# Sentry environment label (optional)
# Typically: production, canari (preprod), or development
# Used to filter and organize errors in Sentry dashboard
OTO_SENTRY_ENV=development

# Sentry release identifier (optional)
# Typically: git SHA or semantic version (e.g., v1.2.3)
# Helps correlate errors with code versions
OTO_SENTRY_RELEASE=

# Sentry performance tracing sample rate (optional)
# Default: 0 (no tracing)
# Set to 0.1 for 10% sampling, 1.0 for 100% tracing (affects performance)
OTO_SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# PERFORMANCE & LOGGING
# =============================================================================

# Log level for the application (optional)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Event loop callback warning threshold in seconds (optional)
# Logs a warning if a callback blocks the event loop longer than this
# Default: 1.0 (1 second)
OTO_SLOW_CALLBACK_WARN=1.0

# Event loop callback Sentry reporting threshold in seconds (optional)
# Reports to Sentry if a callback blocks longer than this (if Sentry enabled)
# Default: 10.0 (10 seconds)
OTO_SLOW_CALLBACK_SENTRY=10.0

# =============================================================================
# QUOTAS & LIMITS
# =============================================================================

# Maximum number of organizations per user (optional)
# Limits org creation to prevent abuse
OTO_MCP_MAX_ORGS_PER_USER=

# Maximum upload size in bytes (optional)
# Applies to file uploads, media, and data imports
OTO_MCP_UPLOAD_MAX_BYTES=

# Invitation TTL in days (optional)
# How long org invitations remain valid before expiration
OTO_MCP_INVITE_TTL_DAYS=7

# Tool call journal retention in days (optional)
# Default: 90 (roughly 3 months)
# Older records are automatically cleaned up
OTO_JOURNAL_RETENTION_DAYS=90

# Run/agent thread retention in days (optional)
# Default: 30 (1 month)
# How long execution logs and thread data are retained
OTO_MCP_RUN_THREAD_RETENTION_DAYS=30

# Unipile feed entry TTL in seconds (optional)
# Retention period for cached messaging/social feed data
OTO_UNIPILE_FEED_TTL_SECONDS=

# Unipile default result limit (optional)
# Default: 5
# Maximum number of results returned in a single Unipile query
OTO_MCP_UNIPILE_DEFAULT_LIMIT=5

# =============================================================================
# RATE LIMITING — ANONYMOUS / PUBLIC ACCESS (optional)
# =============================================================================

# Rate limit — requests per minute for anonymous access (optional)
# Leave empty to disable rate limiting
OTO_ANON_RATE_PER_MIN=

# Rate limit — burst size for anonymous access (optional)
# Maximum requests allowed in a burst (exceeding rate per minute)
OTO_ANON_RATE_BURST=

# =============================================================================
# CORS & NETWORK ACCESS
# =============================================================================

# CORS allowed origins (optional)
# Comma-separated list of frontend URLs that can make cross-origin requests
# Format: https://example.com,https://app.example.com
# ⚠️ If not set, defaults are applied per environment. Always explicitly set in production.
OTO_MCP_CORS_ORIGINS=

# Egress allowlist for internal/private services (optional)
# Comma or newline-separated list of `name=host:port` exceptions for credential-based bridges
# Allows hosted connectors to reach internal services without exposing them publicly
# Format: bridge-name=10.0.0.5:9000,service=127.0.0.1:8080
# ⚠️ Address must be literal IP + port (never hostname alone)
OTO_EGRESS_ALLOW=

# =============================================================================
# INVITATIONS & AUTHENTICATION FLOWS
# =============================================================================

# Base URL for invitation links sent to users (optional)
# Where org invitations redirect the recipient
# If not set, defaults to the dashboard URL
OTO_INVITE_BASE_URL=

# =============================================================================
# DATASTORE & DATA LAYER (optional)
# =============================================================================

# Enforce `origine` (data source) layer requirement from this date (optional)
# Format: YYYY-MM-DD
# From this date forward, all writes to datastores must explicitly declare their data source layer
# If not set, defaults to 2026-10-01
# Determines when nullable `origine` column becomes required
OTO_ORIGINE_REFUS_LE=2026-10-01

# =============================================================================
# MCP TRANSPORT & NETWORKING
# =============================================================================

# MCP transport protocol (optional)
# Valid values: streamable_http (default), stdio (local testing only)
# Production always uses streamable_http with JWT auth
MCP_TRANSPORT=streamable_http

# Server host to bind to (optional)
# Default: 127.0.0.1 (localhost)
# Set to 0.0.0.0 to listen on all interfaces (production behind reverse proxy)
HOST=127.0.0.1

# Server port (optional)
# Default: 9103
PORT=9103

# =============================================================================
# CONTENT & ROUTING
# =============================================================================

# Project domain for published endpoints (optional)
# Default: oto.cx (production)
# Set to oto.ninja for preprod
# Controls subdomain structure: <slug>.mcp.<domain>, <slug>.share.<domain>
OTO_PROJECT_DOMAIN=oto.cx

# Base URL announced by this server (required)
# Production: https://mcp.oto.cx
# Preprod: https://mcp.oto.ninja
# Used by Logto to construct absolute URLs, token validation, etc.
OTO_MCP_PUBLIC_URL=https://mcp.oto.ninja

# =============================================================================
# BACKGROUND JOBS & AUTOMATION (optional)
# =============================================================================

# Enable runner tick for agent fleet automation (optional)
# Default: 1 (enabled)
# Set to 0 to disable background agent execution
OTO_RUNNER_TICK_ENABLED=1

# Claude AI app ID for special integration (optional)
# Used when oto-mcp serves Claude-specific capabilities
OTO_MCP_CLAUDE_APP_ID=

# =============================================================================
# DEPRECATED / REMOVED VARIABLES
# =============================================================================
# The following variables have been removed and are listed for historical reference:
#
# OTO_MCP_OAUTH_PASSWORD (removed 2026-06-13)
#   Replaced by: Logto OAuth 2.0 authentication (LOGTO_ENDPOINT + MCP_AUDIENCE)
#   Single-user MVP password is no longer supported; use organization-based auth
#
# =============================================================================

